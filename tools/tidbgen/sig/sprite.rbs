# Area512 built-in type declaration.

class Sprite
  # Sprite width in pixels
  def width: () -> Integer

  # Sprite height in pixels
  def height: () -> Integer

  # Fill the whole sprite with an RGB888 color
  def fill: (Integer color) -> Sprite

  # Draw a single pixel (x, y, color)
  def pixel: (Integer x, Integer y, Integer color) -> Sprite

  # Draw a line (x0, y0, x1, y1, color)
  def line: (Integer x0, Integer y0, Integer x1, Integer y1, Integer color) -> Sprite

  # Draw a rectangle outline (x, y, w, h, color)
  def rect: (Integer x, Integer y, Integer width, Integer height, Integer color) -> Sprite

  # Draw a filled rectangle (x, y, w, h, color)
  def fill_rect: (Integer x, Integer y, Integer width, Integer height, Integer color) -> Sprite

  # Draw a circle outline (x, y, r, color)
  def circle: (Integer x, Integer y, Integer radius, Integer color) -> Sprite

  # Draw a filled circle (x, y, r, color)
  def fill_circle: (Integer x, Integer y, Integer radius, Integer color) -> Sprite

  # Draw text at (x, y, str, color); efont supports Japanese
  def text: (Integer x, Integer y, String string, Integer color) -> Sprite

  # Transfer the sprite to the screen at (x, y); optional 3rd arg is a transparent color
  def push: (Integer x, Integer y, ?Integer transparent_color) -> Sprite

  # Free the sprite buffer immediately
  def delete: () -> nil

  # Create an off-screen sprite of the given width and height
  def self.new: (Integer width, Integer height, ?Integer font_size) -> Sprite

end
